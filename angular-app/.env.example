# ─── Base de datos (Supabase) ────────────────────────────────────────────────
# Usar la URL del pooler (Transaction mode, puerto 6543) para produccion en Vercel
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Poner a 'false' solo si usas PostgreSQL local sin SSL
# DATABASE_SSL=false

# ─── Autenticacion JWT ────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-en-produccion

# ─── Credenciales de la aplicacion ───────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=cambia-esta-contrasena
AUTH_SESSION_TTL_MS=43200000

# ─── Morningstar ─────────────────────────────────────────────────────────────
# Usar 'mock' para desarrollo local sin acceso a Morningstar real
MORNINGSTAR_PROVIDER=mock
# MORNINGSTAR_BASE_URL=
# MORNINGSTAR_API_KEY=
# MORNINGSTAR_API_TOKEN=

# ─── Cron job (Vercel Cron) ──────────────────────────────────────────────────
# Vercel lo genera automaticamente; para pruebas locales usa cualquier string
# En Vercel: Settings → Environment Variables → CRON_SECRET (valor libre)
CRON_SECRET=cambia-esto-por-un-secreto-del-cron

# ─── Finnhub (recomendado — cubre fondos europeos + acciones) ────────────────
# Registro gratuito en https://finnhub.io → 60 creditos/minuto sin coste
# Prioridad maxima cuando esta definida (sustituye a Twelve Data y Yahoo Finance)
FINNHUB_API_KEY=tu_api_key_aqui

# ─── Twelve Data (alternativa para acciones, no cubre fondos europeos) ────────
# Registro gratuito en https://twelvedata.com → 800 creditos/dia, 8/minuto
# Cuando esta definida, sustituye a Yahoo Finance automaticamente
TWELVE_DATA_API_KEY=tu_api_key_aqui

# ─── Yahoo Finance (fallback si no hay TWELVE_DATA_API_KEY) ───────────────────
YAHOO_ALLOW_INSECURE_TLS=false

# ─── Servidor local ──────────────────────────────────────────────────────────
API_PORT=3000
